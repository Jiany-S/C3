# Copy this file to .env and set the key locally. Never upload .env.
OPENAI_API_KEY=
# A Chat Completions model supporting function calls and JSON mode.
OPENAI_MODEL=gpt-4.1-mini
OPENAI_REVIEW_MODEL=gpt-4.1
ENABLE_REFLECTION=true
LOG_DIR=logs
# Local-only evidence accordion; automatically hidden on Hugging Face Spaces.
SHOW_DEMO_EVIDENCE=true
# Notebook defaults avoid paid calls and avoid launching a server during Run All.
RUN_LIVE=false
RUN_UI=false
